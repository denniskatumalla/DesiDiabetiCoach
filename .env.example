# DesiDiabetiCoach — Environment Variables
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to git

# ─── SUPABASE (Local Dev) ───────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_local_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_local_service_role_key

# ─── ANTHROPIC (Claude API) ─────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-6

# ─── APP CONFIG ─────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development
APP_SECRET=generate_a_random_32_char_string_here

# ─── EMAIL (Resend) ─────────────────────────────────────────────
RESEND_API_KEY=re_your_resend_key_here
EMAIL_FROM=noreply@desidiabeticoach.com

# ─── STORAGE ────────────────────────────────────────────────────
# Supabase Storage is used for meal photos
# No extra config needed for local dev — handled by Supabase local

# ─── MOBILE (Expo / RevenueCat) ─────────────────────────────────
# Set in apps/mobile/.env — not here
# EXPO_PUBLIC_REVENUECAT_API_KEY=your_revenuecat_key

# ─── FEATURE FLAGS ──────────────────────────────────────────────
NEXT_PUBLIC_ENABLE_AI_PHOTO_SCAN=false   # Enable when Claude Vision integrated
NEXT_PUBLIC_ENABLE_MULTILINGUAL=false    # Enable when i18n complete
NEXT_PUBLIC_MAINTENANCE_MODE=false
