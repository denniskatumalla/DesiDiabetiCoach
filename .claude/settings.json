{
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npx *)",
      "Bash(git *)",
      "Bash(node *)",
      "Bash(ts-node *)",
      "Bash(supabase *)",
      "Bash(expo *)",
      "Bash(docker compose *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(mkdir *)",
      "Bash(cat *)",
      "Bash(ls *)",
      "Bash(grep *)"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(curl * | bash)",
      "Bash(wget * | sh)",
      "Bash(npm publish)",
      "Bash(supabase db push --linked)",
      "Bash(vercel --prod)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "echo '[Claude Code] Running: $CLAUDE_TOOL_INPUT_COMMAND'"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "cd /home/claude/desidiabeticoach && npm run lint --if-present 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
