{
  "name": "desidiabeticoach",
  "version": "0.1.0",
  "private": true,
  "description": "AI-powered diabetes management for South Asian communities",
  "author": "Dennis David Katumalla <dennis@casmendora.com>",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "concurrently \"npm run dev:web\" \"npm run dev:mobile\"",
    "dev:web": "cd apps/web && npm run dev",
    "dev:mobile": "cd apps/mobile && npx expo start",
    "dev:db": "docker compose -f infrastructure/dev/docker-compose.yml up -d",
    "dev:db:stop": "docker compose -f infrastructure/dev/docker-compose.yml down",
    "dev:db:reset": "docker compose -f infrastructure/dev/docker-compose.yml down -v && npm run dev:db",
    "build": "cd apps/web && npm run build",
    "test": "npm run test --workspaces --if-present",
    "test:watch": "cd packages/shared && npm run test -- --watch",
    "lint": "cd apps/web && npm run lint",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check:env": "npx ts-node scripts/check-env.ts",
    "db:migrate": "supabase db push",
    "db:seed": "npx ts-node scripts/seed-foods.ts",
    "db:studio": "supabase studio",
    "setup": "node scripts/setup.js"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "@types/react": "~18.2.79",
    "@types/react-dom": "~18.2.25"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "@types/node": "^20.0.0",
    "concurrently": "^8.0.0",
    "dotenv": "^16.4.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.7.2"
  }
}
