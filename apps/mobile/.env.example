# DesiDiabetiCoach — Mobile Environment Variables
# Copy to apps/mobile/.env — NOT the root .env.local (mobile env vars are
# separate, per CLAUDE.md). All must be prefixed EXPO_PUBLIC_ to reach the
# client bundle; never put a service-role or Anthropic key here.

# Same Supabase project as the web app
EXPO_PUBLIC_SUPABASE_URL=http://localhost:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_local_supabase_anon_key

# The deployed web app's URL — mobile calls its tRPC + /api/coach routes
# as the backend (spec §8.3). For local dev, use your machine's LAN IP,
# not localhost (the phone/simulator can't reach your laptop's localhost).
EXPO_PUBLIC_API_URL=http://192.168.1.100:3000

# RevenueCat — Phase 2 (billing), not wired up yet, see docs/ROADMAP.md
# EXPO_PUBLIC_REVENUECAT_API_KEY=
